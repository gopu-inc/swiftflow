// ====================================================
// 8. POLYMORPHISME
// ====================================================
print("--- 8. POLYMORPHISME ---");

class Forme {
    func aire() {
        return 0;
    }
    
    func afficher() {
        print("Forme générique");
    }
}

class Rectangle : Forme {
    var largeur;
    var hauteur;
    
    func init(l, h) {
        this.largeur = l;
        this.hauteur = h;
    }
    
    func aire() {
        return this.largeur * this.hauteur;
    }
    
    func afficher() {
        print("Rectangle", this.largeur, "x", this.hauteur, "aire =", this.aire());
    }
}

class Cercle : Forme {
    var rayon;
    
    func init(r) {
        this.rayon = r;
    }
    
    func aire() {
        return math.PI * this.rayon * this.rayon;
    }
    
    func afficher() {
        print("Cercle rayon", this.rayon, "aire =", this.aire());
    }
}

var formes = [];
// formes[0] = new Rectangle(5, 3);
// formes[1] = new Cercle(4);

// Simulation
var rect = new Rectangle();
rect.init(5, 3);
rect.afficher();

var cercle = new Cercle();
cercle.init(4);
cercle.afficher();

print("");

// ====================================================
// 9. ENCAPSULATION (avec getters/setters simulés)
// ====================================================
print("--- 9. ENCAPSULATION ---");

class CompteBancaire {
    var titulaire;
    private var solde = 0;
    
    func init(titulaire) {
        this.titulaire = titulaire;
    }
    
    func deposer(montant) {
        if (montant > 0) {
            this.solde = this.solde + montant;
            print("Dépôt de", montant, "€ pour", this.titulaire);
        }
    }
    
    func retirer(montant) {
        if (montant > 0 && montant <= this.solde) {
            this.solde = this.solde - montant;
            print("Retrait de", montant, "€ pour", this.titulaire);
        } else {
            print("Solde insuffisant pour", this.titulaire);
        }
    }
    
    func consulterSolde() {
        print("Solde de", this.titulaire, ":", this.solde, "€");
    }
}

var compte = new CompteBancaire();
compte.init("Bob");
compte.consulterSolde();
compte.deposer(1000);
compte.consulterSolde();
compte.retirer(300);
compte.consulterSolde();
compte.retirer(800);  // Devrait échouer

print("");

// ====================================================
// 10. MÉTHODE STATIQUE POUR CRÉATION D'INSTANCES
// ====================================================
print("--- 10. FABRIQUE STATIQUE ---");

class Utilisateur {
    var nom;
    var email;
    
    static func creerAdmin(nom) {
        var user = new Utilisateur();
        user.nom = nom;
        user.email = nom + "@admin.com";
        return user;
    }
    
    func afficher() {
        print("Utilisateur:", this.nom, "Email:", this.email);
    }
}

var admin = Utilisateur.creerAdmin("admin");
admin.afficher();

print("");

