// ====================================================
// 1. DÉFINITION DE CLASSE SIMPLE
// ====================================================
print("--- 1. CLASSE SIMPLE ---");

class Personne {
    var nom;
    var age;
    
    func afficher() {
        print("Nom:", this.nom, "Age:", this.age);
    }
    
    func anniversaire() {
        this.age = this.age + 1;
        print("Joyeux anniversaire", this.nom, "! Maintenant", this.age, "ans");
    }
}

// Création d'instance
var p1 = new Personne();
p1.nom = "Alice";
p1.age = 25;
p1.afficher();
p1.anniversaire();
p1.afficher();

print("");

// ====================================================
// 2. CLASSE AVEC CONSTRUCTEUR (via méthode init)
// ====================================================
print("--- 2. CLASSE AVEC CONSTRUCTEUR ---");

class Livre {
    var titre;
    var auteur;
    var annee;
    
    func init(t, a, an) {
        this.titre = t;
        this.auteur = a;
        this.annee = an;
    }
    
    func decrire() {
        print("Livre:", this.titre, "par", this.auteur, "(", this.annee, ")");
    }
}

var livre1 = new Livre();
livre1.init("1984", "George Orwell", 1949);
livre1.decrire();

var livre2 = new Livre();
livre2.init("Dune", "Frank Herbert", 1965);
livre2.decrire();

print("");

// ====================================================
// 3. HÉRITAGE
// ====================================================
print("--- 3. HÉRITAGE ---");

class Animal {
    var nom;
    var age;
    
    func init(n, a) {
        this.nom = n;
        this.age = a;
    }
    
    func parler() {
        print(this.nom, "fait un bruit");
    }
    
    func vieillir() {
        this.age = this.age + 1;
    }
}

class Chien : Animal {
    var race;
    
    func init(n, a, r) {
        super.init(n, a);
        this.race = r;
    }
    
    func parler() {
        print(this.nom, "dit: Ouaf ouaf ! (Race:", this.race, ")");
    }
    
    func afficherRace() {
        print(this.nom, "est un", this.race);
    }
}

var animal = new Animal();
animal.init("Générique", 5);
animal.parler();

var chien = new Chien();
chien.init("Rex", 3, "Berger Allemand");
chien.parler();
chien.afficherRace();
chien.vieillir();
print(chien.nom, "a maintenant", chien.age, "ans");

print("");

// ====================================================
// 4. STRUCTURE (si implémentée comme classe légère)
// ====================================================
print("--- 4. STRUCTURE ---");

struct Point {
    var x;
    var y;
    
    func init(x, y) {
        this.x = x;
        this.y = y;
    }
    
    func distance(p) {
        var dx = this.x - p.x;
        var dy = this.y - p.y;
        return sqrt(dx*dx + dy*dy);
    }
    
    func afficher() {
        print("Point(", this.x, ",", this.y, ")");
    }
}

var p1 = new Point();
p1.init(0, 0);
var p2 = new Point();
p2.init(3, 4);

p1.afficher();
p2.afficher();
print("Distance entre les points:", p1.distance(p2));

print("");

// ====================================================
// 5. PROPRIÉTÉS STATIQUES (variables de classe)
// ====================================================
print("--- 5. VARIABLES STATIQUES ---");

class Compteur {
    static var total = 0;
    var id;
    
    func init() {
        Compteur.total = Compteur.total + 1;
        this.id = Compteur.total;
    }
    
    func afficher() {
        print("Instance ID:", this.id, "Total instances:", Compteur.total);
    }
}

var c1 = new Compteur();
c1.afficher();
var c2 = new Compteur();
c2.afficher();
var c3 = new Compteur();
c3.afficher();

print("");

// ====================================================
// 6. MÉTHODES STATIQUES
// ====================================================
print("--- 6. MÉTHODES STATIQUES ---");

class MathUtils {
    static func carre(x) {
        return x * x;
    }
    
    static func cube(x) {
        return x * x * x;
    }
    
    static func estPair(x) {
        return (x % 2 == 0);
    }
}

print("MathUtils.carre(5) =", MathUtils.carre(5));
print("MathUtils.cube(3) =", MathUtils.cube(3));
print("MathUtils.estPair(4) =", MathUtils.estPair(4) ? "pair" : "impair");
print("MathUtils.estPair(7) =", MathUtils.estPair(7) ? "pair" : "impair");

print("");

